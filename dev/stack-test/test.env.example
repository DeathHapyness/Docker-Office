# Copie para test.env e ajuste para a sua máquina (test.env não vai para o git).
DATA_DIR=/caminho/para/self-hosted-media-server/data
MEDIA_DIR=/caminho/para/self-hosted-media-server/data/media
# Immich
IMMICH_VERSION=v3
UPLOAD_LOCATION=/caminho/para/self-hosted-media-server/data/immich/library
DB_DATA_LOCATION=/caminho/para/self-hosted-media-server/data/immich/postgres
DB_USERNAME=immich
DB_DATABASE_NAME=immich
DB_PASSWORD=troque-por-um-valor-aleatorio   # openssl rand -hex 16
# Kopia
KOPIA_PASSWORD=troque-por-um-valor-aleatorio
KOPIA_SERVER_USERNAME=admin
KOPIA_SERVER_PASSWORD=troque-por-um-valor-aleatorio
# Speedtest Tracker
SPEEDTEST_APP_KEY=base64:troque   # echo "base64:$(openssl rand -base64 32)"

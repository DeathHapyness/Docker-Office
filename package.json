{
  "name": "docker-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monitoramento Docker com visual de escritório 3D voxel: cada container é um personagem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeathHapyness/Docker-Office.git"
  },
  "scripts": {
    "build:web": "tsc -p web/tsconfig.json",
    "watch:web": "tsc -p web/tsconfig.json --watch",
    "typecheck": "tsc -p web/tsconfig.json --noEmit && tsc -p server/tsconfig.json",
    "test": "node --test \"server/test/*.test.ts\"",
    "serve": "node server/src/index.ts",
    "demo": "DOCKER_OFFICE_DEMO=1 node server/src/index.ts",
    "dev": "npm run build:web && npm run serve"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
